<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= h(post.title) %></title>
  <meta name="description" content="<%= h(post.description) %>">
  <link rel="stylesheet" href="../../styles.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <nav aria-label="Site">
      <a class="back" href="../../">Back to the engineering journal</a>
    </nav>
  </header>

  <main id="main">
    <article class="post">
      <header class="post-header">
        <h1><%= h(post.title) %></h1>

        <% if post.description && !post.description.empty? %>
          <p class="description"><%= h(post.description) %></p>
        <% end %>

        <p class="meta">
          <time datetime="<%= post.date.iso8601 %>"><%= post.date.strftime("%B %-d, %Y") %></time>
          <% if post.tags.any? %>
            <span class="tags" aria-label="Tags">
              <% post.tags.each do |tag| %>
                <span class="tag"><%= h(tag) %></span>
              <% end %>
            </span>
          <% end %>
        </p>
      </header>

      <div class="post-body">
        <%= body_html %>
      </div>
    </article>
  </main>

  <footer class="site-footer">
    <p><a href="../../">Back to the engineering journal</a></p>
  </footer>
</body>
</html>
