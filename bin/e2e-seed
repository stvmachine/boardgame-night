#!/usr/bin/env bash
# Seed script for Playwright e2e tests. Mirrors bin/dev-e2e environment setup.
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use 20.20.2 || { echo "ERROR: nvm use 20.20.2 failed" >&2; exit 1; }
fi

if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init -)"
fi

# Use the persisted Solid Cache store during e2e runs so the seed task and the
# running web server share a single cache (e.g. seeded BGG hot list fixtures).
export RAILS_CACHE_STORE=solid_cache_store

exec bin/rails e2e:seed "$@"
