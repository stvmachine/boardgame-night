#!/usr/bin/env bash

export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use || { echo "ERROR: nvm could not activate the Node version from .nvmrc" >&2; exit 1; }
fi

if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init -)"
fi

exec foreman start -f Procfile.dev "$@"
